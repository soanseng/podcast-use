GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Only needed if you choose --provider openai.
OPENAI_API_KEY=your_openai_api_key_here

# Local LiteLLM endpoint (Taigi ASR + zh-Hant subtitle refinement).
# Call the proxy on :4000 with the master key; :8001 is proxy-internal routing.
LITELLM_BASE_URL=http://100.102.183.27:4000/v1
LITELLM_MASTER_KEY=your_litellm_master_key_here
PODCAST_ASR_MODEL=breeze-asr-26-taigi
PODCAST_REFINE_MODEL=qwen36-genesis

# Optional: route refine/punctuate to any OpenAI-compatible provider
# (commandcode / opencode / Groq / OpenRouter ...). Unset = local LiteLLM endpoint.
PODCAST_REFINE_BASE_URL=https://<provider-host>/v1
PODCAST_REFINE_API_KEY=your_provider_api_key_here
PODCAST_REFINE_MODEL=your_provider_model_here
# Reasoning effort for cloud refine models (DeepSeek V4.1 / OpenCode style): none | low | medium | high | max
PODCAST_REFINE_REASONING=none
